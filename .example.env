# The machine file, .env: what differs per doorman, one line, written by
#
#   npm run setup -- --worker-ip <ip>
#
# on the VM itself. Everything shared by every doorman is in
# network/testnet.env, which npm start loads first. This example is tracked;
# .env is not.

# The worker VM's internal IP: where both doors forward to, the only value
# that differs per doorman.
WORKER_IP=10.128.0.2
