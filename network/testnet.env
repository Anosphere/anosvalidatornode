# network/testnet.env: every value that is the same on every doorman of the
# testnet. Committed; no secrets. npm start and the systemd unit load it
# first and .env, the machine file scripts/setup.js writes (the worker VM's
# internal IP, the one value that differs per doorman), second, so .env
# wins where both name a variable:
#   node --env-file=network/testnet.env --env-file=.env src/server.js
#
# A value shown as "<fill in>" is filled by us once the address exists; the
# server refuses to start while one is still "<fill in>". It is in double
# quotes as in the other two repos' shared files; Node strips the quotes.
#
# The four port lines below must agree with deploy/nginx/doorman.conf, which
# carries the same numbers because nginx reads no env file.

# The worker's two ports behind the internal IP in .env: the validator's and
# the keyholder's, the PORT lines of their own network/testnet.env files.
WORKER_VALIDATOR_PORT=3000
WORKER_KEYHOLDER_PORT=3200

# Where the two doors listen on 127.0.0.1: nginx proxies its port 3000 to
# the first and its port 3200 to the second.
DOOR_VALIDATOR_PORT=8000
DOOR_KEYHOLDER_PORT=8200

# The rate limit, per source IP and per door: a token bucket of RATE_BURST
# tokens refilled at RATE_PER_SECOND; over it, 429 with Retry-After: 1.
RATE_PER_SECOND=5
RATE_BURST=20

# How long a forwarded request may wait for the worker's answer, in seconds
# (a submission waits for every other validator; nginx's proxy_read_timeout
# in doorman.conf is the same 600 s), and how long the health's fetch of
# the worker's /health may take.
WORKER_TIMEOUT_SECONDS=600
HEALTH_TIMEOUT_SECONDS=5

# The certificate chain acme.sh installs for nginx; the door's health reads
# its expiry. World-readable; the key next to it is root's.
TLS_FULLCHAIN_FILE=/etc/doorman/tls/fullchain.pem

# IPv4 addresses that skip the rate limit, comma-separated: the wallet proxy
# servers' own public IPs. The doormen in the registry are added by the
# server and are not listed here.
ALLOWLIST_IPS="89.167.121.152,178.105.176.147"
